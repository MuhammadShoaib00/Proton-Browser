{
  "manifest_version": 3,
  "name": "QuantumX YouTube Ad Blocker",
  "version": "1.0.0",
  "description": "Blocks YouTube video ads, feed/sidebar ads, and dismisses the anti-adblock popup. Ported from the QuantumX browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["ima-stub.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["adblock.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
