{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "agent": {
    "browser": {
      "description": "Agent specialized for browser automation, web scraping, and Playwright tasks in the Proton Browser project.",
      "mode": "all",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "bash": { "npx playwright *": "allow", "*": "ask" },
        "edit": "allow"
      }
    }
  }
}
